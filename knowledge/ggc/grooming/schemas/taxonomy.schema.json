{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:grooming:taxonomy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conversationId",
        "title",
        "interpretation",
        "scope"
      ]
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "enum": [
              "Foundation",
              "Mastery",
              "Advanced",
              "Frontier"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "id",
          "title",
          "order"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "minItems": 6,
      "maxItems": 6
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 19
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "primaryLayer": {
            "enum": [
              "fundamentals",
              "practice",
              "product-science",
              "clinical-evidence",
              "culture-heritage",
              "commercial"
            ]
          },
          "secondaryLayers": {
            "type": "array",
            "items": {
              "enum": [
                "fundamentals",
                "practice",
                "product-science",
                "clinical-evidence",
                "culture-heritage",
                "commercial"
              ]
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "moduleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "sourceSeedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverageGaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "order",
          "title",
          "primaryLayer",
          "secondaryLayers",
          "aliases",
          "outcome",
          "moduleIds",
          "sourceSeedIds",
          "coverageGaps"
        ]
      },
      "minItems": 19,
      "maxItems": 19
    },
    "crossCuttingFacets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bodySite": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hairPattern": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skinContext": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "useSetting": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowledgeKind": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jurisdictionPolicy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bodySite",
        "hairPattern",
        "skinContext",
        "useSetting",
        "knowledgeKind",
        "jurisdictionPolicy"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {
          "const": 19
        },
        "modules": {
          "const": 76
        },
        "topics": {
          "type": "integer",
          "minimum": 400
        },
        "releasedClaims": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "domains",
        "modules",
        "topics",
        "releasedClaims"
      ]
    }
  },
  "required": [
    "version",
    "createdAt",
    "origin",
    "levels",
    "layers",
    "domains",
    "crossCuttingFacets",
    "counts"
  ]
}
