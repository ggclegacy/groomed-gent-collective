{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:grooming:topic",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "domainId": {
      "type": "string",
      "minLength": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Foundation",
        "Mastery",
        "Advanced",
        "Frontier"
      ]
    },
    "researchQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    },
    "prerequisiteModuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relatedDomainIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceSeedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflowState": {
      "enum": [
        "PLANNED",
        "ACQUIRED",
        "EXTRACTED",
        "APPRAISED",
        "REVIEWED",
        "RELEASED",
        "STALE",
        "RETRACTED"
      ]
    },
    "evidenceState": {
      "enum": [
        "UNASSESSED",
        "ESTABLISHED",
        "SUPPORTED",
        "EMERGING",
        "TRADITIONAL",
        "FORMULATION_RATIONALE",
        "ANECDOTAL",
        "MARKETING_CLAIM",
        "REFUTED"
      ]
    },
    "provenanceStatus": {
      "enum": [
        "EDITORIAL"
      ]
    },
    "reviewedAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answerEligible": {
      "const": false
    }
  },
  "required": [
    "id",
    "domainId",
    "moduleId",
    "title",
    "level",
    "researchQuestions",
    "deliverables",
    "prerequisiteModuleIds",
    "relatedDomainIds",
    "sourceSeedIds",
    "workflowState",
    "evidenceState",
    "provenanceStatus",
    "reviewedAt",
    "reviewer",
    "claimIds",
    "answerEligible"
  ]
}
