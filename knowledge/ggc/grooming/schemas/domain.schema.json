{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:grooming:domain",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 19
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "primaryLayer": {
          "enum": [
            "fundamentals",
            "practice",
            "product-science",
            "clinical-evidence",
            "culture-heritage",
            "commercial"
          ]
        },
        "secondaryLayers": {
          "type": "array",
          "items": {
            "enum": [
              "fundamentals",
              "practice",
              "product-science",
              "clinical-evidence",
              "culture-heritage",
              "commercial"
            ]
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "sourceSeedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverageGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "order",
        "title",
        "primaryLayer",
        "secondaryLayers",
        "aliases",
        "outcome",
        "moduleIds",
        "sourceSeedIds",
        "coverageGaps"
      ]
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domainId": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "Foundation",
              "Mastery",
              "Advanced",
              "Frontier"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prerequisiteModuleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "topicIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "completionGate": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "domainId",
          "level",
          "title",
          "prerequisiteModuleIds",
          "topicIds",
          "assessment",
          "completionGate"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "ggc:grooming:topic"
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "domain",
    "modules",
    "topics"
  ]
}
