{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:grooming:claim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "topicIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "workflowState": {
      "enum": [
        "PLANNED",
        "ACQUIRED",
        "EXTRACTED",
        "APPRAISED",
        "REVIEWED",
        "RELEASED",
        "STALE",
        "RETRACTED"
      ]
    },
    "evidenceState": {
      "enum": [
        "UNASSESSED",
        "ESTABLISHED",
        "SUPPORTED",
        "EMERGING",
        "TRADITIONAL",
        "FORMULATION_RATIONALE",
        "ANECDOTAL",
        "MARKETING_CLAIM",
        "REFUTED"
      ]
    },
    "provenanceStatus": {
      "enum": [
        "VERIFIED",
        "DISPUTED",
        "UNKNOWN",
        "EDITORIAL"
      ]
    },
    "scope": {
      "enum": [
        "GROOMING_EDUCATION",
        "PROFESSIONAL_ONLY",
        "MEDICAL_REFERRAL"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": "string",
          "minLength": 1
        },
        "hairSkinContext": {
          "type": "string",
          "minLength": 1
        },
        "bodySite": {
          "type": "string",
          "minLength": 1
        },
        "materialIdentity": {
          "type": "string",
          "minLength": 1
        },
        "concentration": {
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "population",
        "hairSkinContext",
        "bodySite",
        "materialIdentity",
        "concentration",
        "vehicle",
        "route",
        "frequency",
        "duration",
        "jurisdiction",
        "limits"
      ]
    },
    "studySummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design": {
          "type": "string",
          "minLength": 1
        },
        "sampleSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "comparator": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effectEstimate": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "biasAndFunding": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "design",
        "sampleSize",
        "comparator",
        "outcomes",
        "effectEstimate",
        "uncertainty",
        "biasAndFunding"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "CONTEXT"
            ]
          }
        },
        "required": [
          "sourceId",
          "locator",
          "excerpt",
          "relation"
        ]
      }
    },
    "conflictIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reviewerId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "domain-specialist",
              "evidence-reviewer",
              "regulatory-reviewer"
            ]
          },
          "reviewedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "nextReviewAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "decision": {
            "enum": [
              "ACCEPT",
              "REVISE",
              "REJECT"
            ]
          }
        },
        "required": [
          "reviewerId",
          "role",
          "reviewedAt",
          "nextReviewAt",
          "decision"
        ]
      }
    },
    "publicSummary": {
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "commercialApproval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUESTED",
            "PENDING",
            "APPROVED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "productId": {
          "type": [
            "string",
            "null"
          ]
        },
        "formulaVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedWording": {
          "type": [
            "string",
            "null"
          ]
        },
        "approverId": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "productId",
        "formulaVersion",
        "jurisdiction",
        "approvedWording",
        "approverId",
        "expiresAt"
      ]
    }
  },
  "required": [
    "id",
    "topicIds",
    "statement",
    "workflowState",
    "evidenceState",
    "provenanceStatus",
    "scope",
    "applicability",
    "studySummary",
    "citations",
    "conflictIds",
    "reviews",
    "publicSummary",
    "visibility",
    "supersedes",
    "commercialApproval"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "workflowState": {
            "const": "RELEASED"
          }
        },
        "required": [
          "workflowState"
        ]
      },
      "then": {
        "properties": {
          "citations": {
            "minItems": 1
          },
          "reviews": {
            "minItems": 2,
            "items": {
              "properties": {
                "decision": {
                  "const": "ACCEPT"
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "domain-specialist"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "evidence-reviewer"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              }
            ]
          },
          "publicSummary": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "const": "PUBLIC"
          },
          "conflictIds": {
            "maxItems": 0
          },
          "provenanceStatus": {
            "const": "VERIFIED"
          },
          "evidenceState": {
            "not": {
              "enum": [
                "UNASSESSED",
                "MARKETING_CLAIM"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "commercialApproval": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "commercialApproval": {
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1
              },
              "formulaVersion": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "type": "string",
                "minLength": 1
              },
              "approvedWording": {
                "type": "string",
                "minLength": 1
              },
              "approverId": {
                "type": "string",
                "minLength": 1
              },
              "expiresAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
