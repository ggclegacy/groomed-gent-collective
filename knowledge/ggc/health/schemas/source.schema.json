{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:health:source",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "clinical-guideline",
        "primary-study",
        "systematic-review",
        "standard",
        "regulation",
        "textbook",
        "manufacturer",
        "archive",
        "oral-history"
      ]
    },
    "publicationDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "documentVersion": {
      "type": "string",
      "minLength": 1
    },
    "accessedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PERMITTED",
            "LINK_ONLY",
            "RESTRICTED",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "note"
      ]
    },
    "snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "state": {
      "enum": [
        "ACQUIRED",
        "REVIEWED",
        "WITHDRAWN"
      ]
    },
    "reviewerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "correctionOrRetractionCheckedAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "url",
    "publisher",
    "kind",
    "publicationDate",
    "documentVersion",
    "accessedAt",
    "jurisdiction",
    "rights",
    "snapshot",
    "sha256",
    "visibility",
    "state",
    "reviewerId",
    "correctionOrRetractionCheckedAt"
  ]
}
