{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:health:taxonomy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conversationId",
        "title",
        "interpretation",
        "scope"
      ]
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "enum": [
              "Foundation",
              "Mastery",
              "Advanced",
              "Frontier"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "id",
          "title",
          "order"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "minItems": 6,
      "maxItems": 6
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "primaryLayer": {
            "enum": [
              "fundamentals",
              "daily-practice",
              "clinical-literacy",
              "interventions",
              "measurement-frontier",
              "consultation-governance"
            ]
          },
          "secondaryLayers": {
            "type": "array",
            "items": {
              "enum": [
                "fundamentals",
                "daily-practice",
                "clinical-literacy",
                "interventions",
                "measurement-frontier",
                "consultation-governance"
              ]
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "moduleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "sourceSeedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverageGaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "groomingDomainIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^D[0-9]{2}$"
            }
          }
        },
        "required": [
          "id",
          "order",
          "title",
          "primaryLayer",
          "secondaryLayers",
          "aliases",
          "outcome",
          "moduleIds",
          "sourceSeedIds",
          "coverageGaps",
          "groomingDomainIds"
        ]
      },
      "minItems": 36,
      "maxItems": 36
    },
    "crossCuttingFacets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifeStage",
        "populationContext",
        "outcomeType",
        "useSetting",
        "knowledgeKind",
        "jurisdictionPolicy"
      ],
      "properties": {
        "lifeStage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "populationContext": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcomeType": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "useSetting": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowledgeKind": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jurisdictionPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {
          "const": 36
        },
        "modules": {
          "const": 144
        },
        "topics": {
          "type": "integer",
          "minimum": 1000
        },
        "releasedClaims": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "domains",
        "modules",
        "topics",
        "releasedClaims"
      ]
    }
  },
  "required": [
    "version",
    "createdAt",
    "origin",
    "levels",
    "layers",
    "domains",
    "crossCuttingFacets",
    "counts"
  ]
}
