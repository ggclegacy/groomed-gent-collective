{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ggc:health:domain",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "primaryLayer": {
          "enum": [
            "fundamentals",
            "daily-practice",
            "clinical-literacy",
            "interventions",
            "measurement-frontier",
            "consultation-governance"
          ]
        },
        "secondaryLayers": {
          "type": "array",
          "items": {
            "enum": [
              "fundamentals",
              "daily-practice",
              "clinical-literacy",
              "interventions",
              "measurement-frontier",
              "consultation-governance"
            ]
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "sourceSeedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverageGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groomingDomainIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{2}$"
          }
        }
      },
      "required": [
        "id",
        "order",
        "title",
        "primaryLayer",
        "secondaryLayers",
        "aliases",
        "outcome",
        "moduleIds",
        "sourceSeedIds",
        "coverageGaps",
        "groomingDomainIds"
      ]
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domainId": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "Foundation",
              "Mastery",
              "Advanced",
              "Frontier"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prerequisiteModuleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "topicIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "completionGate": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "domainId",
          "level",
          "title",
          "prerequisiteModuleIds",
          "topicIds",
          "assessment",
          "completionGate"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "ggc:health:topic"
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "domain",
    "modules",
    "topics"
  ]
}
