# Public browser token: use a Mapbox pk.* token restricted to your deployment URLs.
# Next.js reads this at build time. Never put a secret sk.* token here.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server only. Enable Mapbox Search Box access/billing; never use NEXT_PUBLIC_ for this.
MAPBOX_SEARCH_TOKEN=
# Existing member account setup is required for paid discovery; see .env.accounts.example.
# Existing Cassius AI trip planning remains optional and separate from heuristic discovery.
OPENAI_API_KEY=
CASSIUS_ENABLED=true
CASSIUS_OPENAI_MODEL=
