# Disabled by default. Populate in the approved deployment environment.
GGC_ACCOUNT_PROVIDER=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
DATABASE_URL=
GGC_OWNER_ID=
# Direct isolated-branch URL for migrations, separate from the application URL.
GGC_MIGRATION_DATABASE_URL=
# Public account setup: use clerk-neon above, enable verified email in Clerk.
# Sign-up and sign-in routes finish at /auth/continue (resumes onboarding or opens Command).
# Google/Apple options appear only when configured in the Clerk dashboard.
# Existing Cassius AI key is optional for profiles; required for AI conversations.
# OPENAI_API_KEY=
# CASSIUS_OPENAI_MODEL=

# Full activation, provider credentials, roles, migration and phone checklist:
# docs/account-authentication.md
# GGC_OWNER_ID is the verified Clerk user ID of the initial founder.
# Do not commit real keys. Configure provider secrets in Clerk, not NEXT_PUBLIC variables.
